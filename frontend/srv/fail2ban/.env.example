# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Fail2ban Configuration
FAIL2BAN_DOMAIN=fail2ban.vincentsimard.ca
FAIL2BAN_PORT=8080
TZ=UTC

# Volume paths
FAIL2BAN_CONFIG=./fail2ban-config
FAIL2BAN_RUN=./f2b-run
FAIL2BAN_UI_CONFIG=./config

# Log paths
HOST_LOG_PATH=/var/log
APACHE_LOG_PATH=/var/log/httpd
